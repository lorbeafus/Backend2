    {
      "name": "03. Eventos",
      "item": [
        {
          "name": "Listar Eventos (con Filtros y Paginación)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events?status=published&page=1&limit=5&sort=date",
